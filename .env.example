# Optional. Without it, request parsing and contract extraction run offline heuristics.
ANTHROPIC_API_KEY=

# Optional. A Postgres connection string. With it, accounts, sessions and the app's state are saved there.
# Without it everything stays in memory and is lost on restart, which is fine for local runs and the rehearsal.
DATABASE_URL=

# Optional. A Resend API key. With it, Agora emails confirmation links, password-reset links and approval notices.
# Without it nothing is sent and accounts still work. EMAIL_FROM must be an address on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Agora <no-reply@agora.ethoslabs.us>
# Optional. Where links in emails point. Defaults to the live site on Railway and to the request's address locally.
APP_URL=
