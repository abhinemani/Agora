{
  "name": "agora-storefront",
  "version": "0.1.0",
  "private": true,
  "description": "Marketplace 2.0 prototype: one local government's storefront, its suppliers, and a visible revenue ledger.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "rehearse": "node scripts/rehearse-demo.cjs",
    "eval": "tsx scripts/eval.ts",
    "seed:contracts": "node scripts/generate-sample-contracts.mjs",
    "import:catalog": "node scripts/import-price-catalog.mjs && node scripts/feature-tyler.mjs && node scripts/name-tyler.mjs && node scripts/import-price-catalog.mjs tyler-technologies-naspo-ar3764-catalog-2026-09.xlsx tyler-technologies-naspo-ar3764-2026-09.json",
    "import:naspo": "NODE_USE_ENV_PROXY=1 node scripts/import-naspo.mjs",
    "import:coops": "tsx scripts/import-coop-data.ts",
    "import:catalog-coops": "tsx scripts/import-catalog.ts",
    "fetch:federal": "NODE_USE_ENV_PROXY=1 tsx scripts/fetch-federal-ids.ts",
    "fetch:gsa": "NODE_USE_ENV_PROXY=1 tsx scripts/fetch-gsa.ts",
    "fetch:rosters": "NODE_USE_ENV_PROXY=1 tsx scripts/fetch-rosters.ts",
    "import:price-files": "tsx scripts/import-price-files.ts",
    "import:state-rules": "tsx scripts/import-state-rules.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@types/pg": "^8.23.1",
    "mammoth": "^1.13.0",
    "next": "^15.5.28",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uswds/uswds": "^3.13.0",
    "autoprefixer": "^10.6.2",
    "docx": "^9.15.0",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
